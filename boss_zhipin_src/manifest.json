{
  "manifest_version": 3,
  "name": "BossMaxxing - Boss直聘 AI 求职破冰与简历助手",
  "version": "1.0.0",
  "description": "专为 Boss直聘 打造的 AI 求职与招聘僚机：千人千面定制破冰打招呼语、高情商回复 HR 盘问、按岗位 JD 一键重构简历。始终由你点击发送，100% 安全防封号。",
  "permissions": [
    "storage",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "https://*.zhipin.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 BossMaxxing 助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "打开 BossMaxxing 侧边栏"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
