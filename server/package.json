{
  "name": "replymaxxing-worker",
  "version": "2.5.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "sync-data": "node scripts/sync-upstream.mjs",
    "db:init:local": "wrangler d1 execute replymaxxing-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute replymaxxing-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.83.0"
  }
}
